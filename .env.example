# Copy to .env and edit.

# PostgreSQL with the pgcrypto and vector (pgvector) extensions available.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/srm_attendance
DB_POOL_SIZE=10

# Web process
PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development

# Long random string. Required in production. Changing it signs nobody out, but
# invalidates open forms (CSRF tokens).
SESSION_SECRET=change-me-to-a-long-random-string

# Set both to true when the app is served over HTTPS behind a reverse proxy.
COOKIE_SECURE=false
TRUST_PROXY=false

# Uploaded files and generated reports. Keep it outside any web root.
STORAGE_DIR=./storage

# Email (password reset links and queued alerts). Leave SMTP_HOST empty to keep
# emails in attendance.email_queue without sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=attendance@example.edu

# Worker timing
WORKER_INGEST_MS=5000
WORKER_CLOSE_MS=60000
WORKER_BATCH_SIZE=500

# Integration tests only: a database whose name contains "test". It is wiped on every run.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/srm_attendance_test

# Students' enrolment photos are saved here, one folder per register number.
# Default: var/photos inside the project.
# PHOTO_DIR=C:\attendance\var\photos

# The Python that has recognition/requirements.txt installed. Leave empty to use a virtual
# environment named venv or .venv in the recognition folder or the project folder, else "python".
# PYTHON_BIN=C:\path\to\recognition\venv\Scripts\python.exe

# Face model used for enrolment and recognition: buffalo_l (accurate) or buffalo_sc (fast).
# FACE_MODEL=buffalo_l
