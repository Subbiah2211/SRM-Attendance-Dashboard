<%# Four pictures for the sign-in page. A photo in public/img/login replaces the drawing of the same name. %>
<% const tile = function (name, caption, svg) { const photo = loginPhoto(name); %>
  <figure class="art-tile art-<%= name %>">
    <% if (photo) { %><img src="<%= photo %>" alt=""><% } else { %><%- svg %><% } %>
    <figcaption><%= caption %></figcaption>
  </figure>
<% }; %>
<div class="art-grid" aria-hidden="true">
