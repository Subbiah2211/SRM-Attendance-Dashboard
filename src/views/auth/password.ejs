<%- include('../partials/top') %>
<div class="head"><div><h1>Change password</h1>
<p><%= forced ? 'You are using a one-time password. Choose your own before you continue.' : 'At least 8 characters, with a letter and a number.' %></p></div></div>
<form class="card narrow" method="post" action="/password">
  <%- include('../partials/csrf') %>
  <h2>New password</h2>
  <div class="field"><label for="cp">Current password</label><input id="cp" name="current_password" type="password" autocomplete="current-password" required></div>
  <div class="field"><label for="np">New password</label><input id="np" name="new_password" type="password" autocomplete="new-password" minlength="8" required></div>
  <div class="field"><label for="np2">New password again</label><input id="np2" name="confirm_password" type="password" autocomplete="new-password" minlength="8" required></div>
  <button class="btn" type="submit">Change password</button>
</form>
<%- include('../partials/bottom') %>
