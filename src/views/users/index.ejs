<%- include('../partials/top') %>
<div class="head"><div><h1>Users</h1><p><%= my.collegeName || 'Superadmins and college admins. Choose a college to see its other users.' %></p></div>
  <div class="actions"><% if (can('users', 'edit') && creatable.length) { %><a class="btn" href="/users/new"><%- ui.icon('plus', 18) %>Add a user</a><% } %>
    <% if (can('master_data', 'edit') && my.collegeId) { %><a class="btn btn-quiet" href="/imports"><%- ui.icon('upload', 18) %>Upload staff or students</a><% } %></div></div>
<form class="filters" method="get" action="/users">
  <div class="wide"><label for="q">Search</label><input id="q" type="search" name="q" value="<%= filters.q %>" placeholder="Name, username, code"></div>
  <div><label for="role">Role</label><select id="role" name="role"><option value="">All roles</option>
    <% ['admin', 'hod', 'staff', 'student'].forEach(function (r) { %><option value="<%= r %>"<%= filters.role === r ? ' selected' : '' %>><%= ui.role(r) %></option><% }) %></select></div>
  <div><label for="department_id">Department</label><select id="department_id" name="department_id"><option value="">All</option>
    <% departments.forEach(function (o) { %><option value="<%= o.value %>"<%= filters.department_id === o.value ? ' selected' : '' %>><%= o.label %></option><% }) %></select></div>
  <div><label for="status">Status</label><select id="status" name="status"><option value="">All</option><option value="active"<%= filters.status === 'active' ? ' selected' : '' %>>Active</option><option value="inactive"<%= filters.status === 'inactive' ? ' selected' : '' %>>Inactive</option></select></div>
  <div><button class="btn btn-quiet" type="submit">Apply</button></div>
</form>
<div class="card flush"><div class="scroll"><table class="data">
  <thead><tr><th>Name</th><th>Username</th><th>Role</th><th>Department</th><th>Last sign-in</th><th>Status</th><th></th></tr></thead><tbody>
  <% users.forEach(function (u) { %><tr><td><span class="person"><%- ui.avatar(u.name) %><span><b><%= u.name %></b><small><%= u.staff_code || u.register_no || u.email || '' %></small></span></span></td>
    <td><%= u.username %></td><td><span class="chip chip-role"><%= ui.role(u.role_name) %></span></td><td><%= u.department_code || '' %></td>
    <td class="nw"><%= u.last_login_at ? dates.fmtDateTime(u.last_login_at, my.timezone) : 'Never' %></td>
    <td><span class="chip <%= u.status === 'active' ? 'chip-present' : 'chip-none' %>"><%= u.status === 'active' ? 'Active' : 'Inactive' %></span><%= u.locked_until && new Date(u.locked_until) > new Date() ? ' locked' : '' %></td>
    <td><span class="rowlinks"><% if (can('users', 'edit')) { %><a href="/users/<%= u.user_id %>/edit">Edit</a>
        <form class="inline" method="post" action="/users/<%= u.user_id %>/reset-password" data-confirm="Give <%= u.username %> a new one-time password?"><%- include('../partials/csrf') %><button class="btn btn-quiet btn-small" type="submit">Reset password</button></form><% } %>
      <% if (can('users', 'delete') && u.user_id !== user.userId) { %><form class="inline" method="post" action="/users/<%= u.user_id %>/status"><%- include('../partials/csrf') %>
        <input type="hidden" name="status" value="<%= u.status === 'active' ? 'inactive' : 'active' %>"><button class="btn btn-small <%= u.status === 'active' ? 'btn-danger' : 'btn-quiet' %>" type="submit"><%= u.status === 'active' ? 'Deactivate' : 'Reactivate' %></button></form><% } %></span></td></tr><% }) %>
  <% if (!users.length) { %><tr><td colspan="7" class="empty">No users match.</td></tr><% } %>
  </tbody></table></div><%- include('../partials/pager') %></div>
<%- include('../partials/bottom') %>
